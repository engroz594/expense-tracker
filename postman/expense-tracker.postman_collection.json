{
  "info": {
    "_postman_id": "299e431b-59eb-5309-8ac8-dc36fa79a2a0",
    "name": "Expense Tracker API",
    "description": "Every endpoint of the API. Run the folders in order (Collection Runner): Auth stores the tokens, Categories stores categoryId, Expenses stores expenseId and the ETag, Reports runs while the expense exists, Clean up deletes it (and its receipt) and logs out. Set baseUrl in the environment (default http://localhost:8000). The S3 upload request needs a real PNG chosen for its 'file' field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
