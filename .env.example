# Copy to .env and fill in. Never commit .env.
# Postgres and Redis run outside the app (on your machine locally). When the app runs
# in docker compose, compose overrides DB_HOST/REDIS_HOST to host.docker.internal.

DEBUG=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=expense
DB_PASSWORD=change-me
DB_NAME=expense_tracker

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# S3. On AWS leave the keys and endpoint unset: the app uses the ECS task's IAM role.
# Locally, point S3_ENDPOINT_URL at MinIO/LocalStack and set its keys.
S3_BUCKET=expense-tracker
S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=