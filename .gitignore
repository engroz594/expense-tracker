.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Redis snapshot (written to the directory redis-server was started from)
dump.rdb

# IDE / OS
.idea/
.vscode/
.DS_Store

# Claude Code local settings (machine-specific)
.claude/settings.local.json